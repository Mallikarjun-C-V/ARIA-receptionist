# ============================================================
# ARIA Receptionist - Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aria_receptionist

# Gemini AI — free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# ── EMAIL (Nodemailer via Gmail) ─────────────────────────────
# Use your Gmail address
EMAIL_USER=your_gmail@gmail.com
# App Password (NOT your normal password):
#   Go to Google Account → Security → 2-Step Verification → App Passwords
#   Create app password → copy the 16-char code here
EMAIL_PASS=your_16_char_app_password
# Name shown in From field
EMAIL_FROM_NAME=The Velvet Room

# ── GOOGLE SHEETS ────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create project → Enable "Google Sheets API"
# 3. Create Service Account → Download JSON key file
# 4. Copy values from the JSON file into these fields:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@your-project.iam.gserviceaccount.com
# The private key — copy exactly including -----BEGIN/END----- lines
# Replace real newlines with \n
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
# 5. Create a Google Sheet → share it with GOOGLE_SERVICE_ACCOUNT_EMAIL (Editor)
# 6. Copy the Sheet ID from the URL:
#    https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ElevenLabs TTS (optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
