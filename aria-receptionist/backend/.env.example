# ============================================================
# ARIA Receptionist — Backend Environment Variables
# ============================================================

PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aria_receptionist

# Gemini AI — free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — frontend + admin origins
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ── ADMIN CREDENTIALS ────────────────────────────────────────
# Login credentials for the admin dashboard (http://localhost:5174)
ADMIN_USERNAME=your_user_name
ADMIN_PASSWORD=your_password
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production

# ── EMAIL (Gmail App Password) ───────────────────────────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM_NAME=The Velvet Room

# ── GOOGLE SHEETS ────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY\n-----END RSA PRIVATE KEY-----"
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ElevenLabs TTS (optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
